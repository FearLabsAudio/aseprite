<gui>
<window id="color_mode" text="@.title">
  <vbox>
    <view id="color_mode_view" expansive="true">
      <listbox id="color_mode" />
    </view>
    <hbox id="dithering_placeholder" />
    <hbox id="amount">
      <label text="@.amount" for="factor" />
      <slider min="0" max="100" id="factor" minwidth="100" />
      <label text="%" for="factor" />
    </hbox>

    <combobox id="to_gray_combobox">
      <listitem text="!Luminance" />
      <listitem text="!HSV" />
      <listitem text="!HSL" />
    </combobox>

    <vbox id="rgb_adjustments">
      <label text="@.adjust_rgb" />
      <grid columns="2">
        <label text="@brightness_contrast.brightness_label" for="brightness" />
        <slider min="-100" max="100" id="brightness" minwidth="140" cell_align="horizontal" />
        <label text="@brightness_contrast.contrast_label" for="contrast" />
        <slider min="-100" max="100" id="contrast" minwidth="140" cell_align="horizontal" />
      </grid>
    </vbox>

    <check text="@.optimal" id="optimal" />
    <vbox id="optimal_options">
      <grid columns="2">
        <label text="@.artwork_colors" for="artwork_colors" />
        <slider min="1" max="13" id="artwork_colors" cell_align="horizontal" />
        <label text="@.transparency" for="transparency" />
        <combobox id="transparency" cell_align="horizontal">
          <listitem text="@.alpha_cutoff" />
          <listitem text="@.dither_transparency" />
        </combobox>
        <label id="alpha_cutoff_label" text="@.alpha_cutoff" for="alpha_cutoff" />
        <slider min="1" max="255" id="alpha_cutoff" cell_align="horizontal" />
        <label id="transparency_dither_label" text="@.transparency_dither_amount" for="transparency_dither_amount" />
        <hbox id="transparency_dither_controls" cell_align="horizontal">
          <slider min="0" max="100" id="transparency_dither_amount" expansive="true" />
          <label text="%" for="transparency_dither_amount" />
        </hbox>
      </grid>
      <label text="@.optimal_scope" />
    </vbox>
    <vbox id="destination_palette">
      <label id="destination_palette_label" text="!Destination palette:" />
      <view id="destination_palette_view" minheight="16" maxheight="64">
        <grid id="destination_swatches" columns="16" />
      </view>
      <label id="optimal_status" />
    </vbox>
    <check text="@.flatten" id="flatten" />

    <check id="advanced_check" text="@general.advanced_options" />
    <grid id="advanced" columns="2">
      <label text="@rgbmap_algorithm_selector.label" for="rgbmap_algorithm_selector" />
      <hbox id="rgbmap_algorithm_placeholder" cell_align="horizontal" />

      <label text="@best_fit_criteria_selector.label" for="best_fit_criteria_selector" />
      <hbox id="best_fit_criteria_placeholder" cell_align="horizontal" />
    </grid>

    <separator horizontal="true" />
    <check id="preview" text="@filters.preview" selected="true" />
    <hbox>
      <slider min="0" max="100" id="progress" minwidth="100" />
      <boxfiller />
      <hbox homogeneous="true">
        <button text="@general.ok" closewindow="true" id="ok" magnet="true" minwidth="60" />
        <button text="@general.cancel" closewindow="true" />
      </hbox>
    </hbox>
  </vbox>
</window>
</gui>
